def listar(cinema):
    print("Os filmes que temos em exibição são:")
    for sala in cinema: 
        print(f"Filme: {sala[2]}, Lugares: {sala[0]}, Vendidos: {sala[1]}")
    return

def disponivel(cinema,filme,lugar):
    for sala in cinema: 
        if filme == sala[2]: 
            if lugar in sala[1]:
                return False 
            else:
                return True
    return f"O filme '{filme}' não está em exibição."

def vendebilhete(cinema,filme,lugar):
    for sala in cinema: 
        if filme == sala[2]: 
            if lugar not in sala[1]:
                sala[1].append(lugar)
                print(f"Ocupou o lugar {lugar} no filme '{filme}' com sucesso!")
                print(f"Filme: {sala[2]}, Lugares: {sala[0]}, Vendidos: {sala[1]}")
                return
            else:
                print(f"O lugar {lugar} já está ocupado no filme '{filme}'.")
                return
    print(f"O filme '{filme}' não está em exibição.")

def listardisponibilidades(cinema): 
    print("O número de lugares ainda disponíveis em cada sessão são:")
    for sala in cinema: 
        total = sala[0]
        ocupados = len(sala[1])
        disponiveis = total - ocupados
        print(f"Filme: {sala[2]}, Lugares disponíveis: {disponiveis}")
    return

def inserirsala(cinema,salanova): 
    for sala in cinema: 
        if sala[2] == salanova[2]:
            print(f"A sala '{sala[2]}' já existe.")
            return listar(cinema) 
    cinema.append(salanova)
    print(f"A sala '{salanova[2]}' foi adicionada com sucesso.")
    return listar(cinema)


